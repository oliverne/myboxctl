{
  "files": {
    "includes": ["**", "!!**/*.md", "!!dist", "!!release", "!!node_modules", "!!coverage"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
