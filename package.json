{
  "name": "myboxctl",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "bin": {
    "myboxctl": "./dist/cli.js"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun run scripts/build.ts",
    "build:release": "bun run scripts/build-release.ts",
    "prepare:npm": "bun run scripts/prepare-npm.ts",
    "publish:npm": "bun run scripts/publish-npm.ts",
    "verify:release": "bun run scripts/verify-release.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "bun run format:code && bun run format:md",
    "format:code": "biome check --write .",
    "format:md": "prettier --write \"**/*.md\"",
    "test": "bun test",
    "test:release": "bun run build && bun test test/cli/release-contract.test.ts",
    "test:integration": "MYBOX_INTEGRATION=1 bun test test/integration",
    "test:download-probe": "MYBOX_DOWNLOAD_PROBE=1 bun test test/integration/download-contract.test.ts",
    "test:phase10-probe": "MYBOX_PHASE10_PROBE=1 bun test test/integration/cross-implementation-hardening.test.ts",
    "test:phase12-probe": "MYBOX_PHASE12_PROBE=1 bun test test/integration/cross-platform-unicode-filenames.test.ts",
    "test:upload-probe": "MYBOX_UPLOAD_PROBE=1 bun test test/integration/upload-contract.test.ts",
    "test:contract": "MYBOX_CONTRACT=1 bun test test/integration/api-contract.test.ts",
    "check": "bun run typecheck && bun run lint && bun run build && bun test"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/bun": "^1.4.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
